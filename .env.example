# Postgres connection string (Utplava's managed database provides this)
DATABASE_URL=
# Any long random text, 24+ characters. Keeps logins signed.
SESSION_SECRET=
# A one-time code you type on /setup to create the owner login.
SETUP_CODE=
# Optional: email reminders (https://resend.com). Sender must be on a domain verified there.
RESEND_API_KEY=
REMINDER_FROM=
# Optional: the app's address, used for links in reminder emails.
BOOKS_URL=
# Optional: 24+ random characters; the daily GitHub workflow sends it to /api/reminders.
CRON_SECRET=
